# MultiHopper environment: "devnet" or "mainnet"
MH_ENV=devnet

# Devnet API key (issued at https://devnet.multihopper.com/developer/dashboard)
MH_API_KEY=mh_test_replace_with_your_devnet_key

# Optional explicit base URL override
# MH_BASE_URL=https://devnet.multihopper.com/api/v1

# Solana JSON-RPC endpoint matching MH_ENV
SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58-encoded sourceOwner secret key (never commit real keys)
SOLANA_PRIVATE_KEY=

# Webhook HMAC-SHA256 signing secret returned by POST /api/v1/webhooks (whsec_...)
MH_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# Local webhook server port
WEBHOOK_PORT=8787

# Optional Vite dashboard defaults (public non-secret config)
VITE_MH_ENV=devnet
