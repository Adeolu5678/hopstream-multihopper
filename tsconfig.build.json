{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/client/**/*.ts",
    "src/orchestrator/**/*.ts",
    "src/webhook/**/*.ts",
    "src/scheduler/**/*.ts",
    "src/cli.ts",
    "src/index.ts"
  ]
}
